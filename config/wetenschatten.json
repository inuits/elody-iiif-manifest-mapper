{
  "name": "Wetenschatten",
  "description": "4 eeuwen kustonderzoek in Beeld",
  "iiifVersion": 3,
  "rightsUri": "http://creativecommons.org/licenses/by-nc-sa/4.0/",
  "attribution": "Vlaams Instituut voor de Zee (VLIZ)",
  "baseUrl": "http://localhost:8080",

  "traversalSteps": [
    {
      "relationType": "hasContext",
      "mapsToIIIF": "Collection",
      "order": 1,
      "includeThumbnails": true,
      "inverse": true,
      "targetType": "album"
    },
    {
      "relationType": "hasAlbum",
      "mapsToIIIF": "Collection",
      "order": 2,
      "inverse": true,
      "targetType": "media"
    },
    {
      "relationType": "belongsTo",
      "mapsToIIIF": "Manifest",
      "order": 3,
      "inverse": true,
      "targetType": "mediafile"
    }
  ],

  "metadataMappings": [
    {"elodyKey": "title", "iiifProperty": "label", "language": "nl"},
    {"elodyKey": "description", "iiifProperty": "summary", "language": "nl"},
    {"elodyKey": "description", "iiifProperty": "Beschrijving", "language": "nl"},
    {"source": "parent", "relationType": "hasCreator", "relatedKey": "name", "iiifProperty": "Auteur", "language": "nl", "maxValues": 3},
    {"source": "parent", "elodyKey": "publication", "iiifProperty": "Publicatie", "language": "nl", "maxValues": 2},
    {"source": "parent", "elodyKey": "theme", "iiifProperty": "Thema", "language": "nl"},
    {"source": "parent", "elodyKey": "publication", "iiifProperty": "Periode", "language": "nl", "regex": "\\((\\d{4})\\)"}
  ]
}
