{
  "name": "Wetenschatten",
  "description": "4 eeuwen kustonderzoek in Beeld",
  "iiifVersion": 3,
  "rightsUri": "http://creativecommons.org/licenses/by-nc-sa/4.0/",
  "attribution": "Vlaams Instituut voor de Zee (VLIZ)",
  "baseUrl": "http://localhost:8080",

  "traversalSteps": [
    {
      "relationType": "hasContext",
      "mapsToIIIF": "Collection",
      "order": 1,
      "includeThumbnails": true,
      "inverse": true,
      "targetType": "album"
    },
    {
      "relationType": "hasAlbum",
      "mapsToIIIF": "Collection",
      "order": 2,
      "inverse": true,
      "targetType": "media"
    },
    {
      "relationType": "belongsTo",
      "mapsToIIIF": "Manifest",
      "order": 3,
      "inverse": true,
      "targetType": "mediafile"
    }
  ],

  "metadataMappings": [
    {"elodyKey": "title", "iiifProperty": "label", "language": "nl"},
    {"elodyKey": "description", "iiifProperty": "summary", "language": "nl"},
    {"elodyKey": "description", "iiifProperty": "Beschrijving", "language": "nl"},

    {"elodyKey": "title", "iiifProperty": "Auteur", "language": "nl", "regex": "^([^(]+?)\\s*\\("},
    {"elodyKey": "title", "iiifProperty": "Periode", "language": "nl", "regex": "\\((\\d{4})"},

    {"source": "parent", "elodyKey": "title", "iiifProperty": "Thema", "language": "nl", "regex": "^([^|]+?)\\s*\\|"},
    {"source": "parent", "relationType": "hasAlbum", "relatedKey": "title", "iiifProperty": "Album", "language": "nl"},
    {"source": "parent", "relationType": "hasMarineRegion", "relatedKey": "prefLabel", "iiifProperty": "Locatie", "language": "nl"}
  ]
}
